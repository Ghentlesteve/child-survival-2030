	partition progress = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "progress.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"area_code", type text}, {"indicator_code", type text}, {"base_year", Int64.Type}, {"base_value", type number}, {"latest_year", Int64.Type}, {"latest_value", type number}, {"latest_lower", type number}, {"latest_upper", type number}, {"target", Int64.Type}, {"gap_to_target", type number}, {"arr_achieved", type number}, {"arr_required", type number}, {"status", type text}, {"status_order", Int64.Type}, {"projected_2030", type number}, {"year_target_reached", type number}, {"when_target_reached", type text}, {"crisis_in_period", type logical}, {"births_latest", type number}, {"excess_deaths_vs_target", type number}, {"above_secondary", type logical}}, "en-US")
				in
					Typed

