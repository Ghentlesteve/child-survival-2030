model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["areas", "indicators", "years", "estimates", "progress", "DataFolder"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["TMDLView_Desktop","DaxQueryView_Desktop","DevMode"]

annotation PBIDesktopVersion = 2.145.1602.0 (25.07)+10647c9fa319b5e39936cdb21328038c371d1fe4

ref table areas
ref table indicators
ref table years
ref table estimates
ref table progress
ref table 'Time View'
ref table 'Ranking Metric'
ref table 'Scenario ARR'
ref table 'Peer Country'

ref cultureInfo en-US

